# Neon Postgres — get from neon.tech dashboard (use the pooled connection string)
DATABASE_URL=
# ── Email ──
# Resend, so mail comes from our own domain instead of a Gmail address.
# Get the key at resend.com → API Keys (it is shown once). When this is set it
# takes precedence over the Gmail pair below; unset it to fall back.
RESEND_API_KEY=
# Envelope From. Must be an address on a domain verified in Resend, or every
# send is rejected with a 403. Ignored by the Gmail fallback, which can only
# send as GMAIL_USER.
MAIL_FROM=Make My Coffee <orders@makemycoffee.cafe>

# Gmail — the fallback. Generate an App Password at myaccount.google.com/apppasswords
GMAIL_USER=gimelcontz@gmail.com
GMAIL_APP_PASSWORD=

# Admin notification recipient. Also used as the Reply-To on customer mail, so
# a customer answering a shipping notice (or sending a payment screenshot)
# reaches a human.
ADMIN_EMAIL=gimelcontz@gmail.com

# Staff BCC'd on every email we send — comma-separated, optional.
BCC_EMAIL=

# Admin backoffice credentials — set your own; do not use defaults in production
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Lalamove API Keys — sandbox pair from partnerportal.lalamove.com (Developers tab)
LALAMOVE_API_KEY=
LALAMOVE_SECRET_KEY=
# 'production' switches base URL + uses live keys/wallet; omit or leave unset for sandbox
LALAMOVE_ENV=
# Market code — PH covers the whole Philippines; leave unset to default to PH
LALAMOVE_MARKET=
# Pickup location Lalamove quotes FROM (your shop). Get lat/lng by right-clicking
# the spot on Google Maps and copying the coordinates shown. Until all three of
# these are set, checkout silently falls back to the flat ₱99 rate — no quote call
# is made.
LALAMOVE_PICKUP_ADDRESS=
LALAMOVE_PICKUP_LAT=
LALAMOVE_PICKUP_LNG=

# ── Messenger chat + bot (issue #11) ──
# Page ID or Page username, from Meta Business Suite → Page → Settings. Public
# by design. Drives the m.me chat launcher, which renders only when this is set.
# (Meta's embeddable Chat Plugin was discontinued 2024-05-09; an m.me link is
# what replaced it, and it needs no SDK and no domain allowlisting.)
NEXT_PUBLIC_FB_PAGE_ID=
# Page access token — Meta app → Messenger → Settings → Access Tokens. Shown
# once. Invalidated by a password change or a permissions change, so "the bot
# went silent" is usually this.
FB_PAGE_ACCESS_TOKEN=
# App secret — Meta app → Settings → Basic. Verifies X-Hub-Signature-256 on
# every webhook delivery. Without it the webhook refuses everything, which is
# the correct failure mode for a public URL.
FB_APP_SECRET=
# Invent one (openssl rand -hex 24). Must match what you type into the Meta
# webhook config; it is only used for the subscription handshake.
FB_VERIFY_TOKEN=
# Free-text replies. Without it the bot still works — buttons only.
ANTHROPIC_API_KEY=

# Random secret for session tokens — generate with: openssl rand -hex 32
SESSION_SECRET=
