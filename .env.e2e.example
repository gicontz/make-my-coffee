# Playwright end-to-end configuration. Copy to `.env.e2e` (gitignored).
#
# E2E_DATABASE_URL MUST point at a throwaway database — the suite creates and
# deletes orders, vouchers and redemptions, and asserts on exact redemption
# counts. The cheapest safe option is a Neon *branch* of the production
# database (Neon console → Branches → New branch): it is an instant
# copy-on-write clone with its own connection string, free on the current plan,
# and deleting it afterwards costs nothing.
#
# e2e/helpers/db.ts refuses to run if this equals the DATABASE_URL in
# .env.local, so a mistyped value fails loudly instead of writing test orders
# into the real shop.
E2E_DATABASE_URL=postgresql://user:password@ep-your-test-branch-pooler.region.aws.neon.tech/makemycoffee?sslmode=require

# Credentials the test server runs with — deliberately not the real ones.
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=e2e-password
E2E_SESSION_SECRET=e2e-session-secret

# Port for the dev server Playwright starts.
E2E_PORT=3100
